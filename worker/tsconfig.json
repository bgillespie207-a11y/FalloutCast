{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022"],
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true
  },
  // worker-configuration.d.ts is generated by `wrangler types` from
  // wrangler.jsonc -- it declares Env (the ASSETS and FALLOUTCAST_API
  // bindings) plus the runtime types, so bindings stay in sync with config.
  // Rerun `npx wrangler types` after changing wrangler.jsonc.
  "include": ["*.ts", "../worker-configuration.d.ts"]
}
