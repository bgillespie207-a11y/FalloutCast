{
  "name": "falloutcast-deploy",
  "private": true,
  "version": "0.3.0",
  "description": "Cloudflare Worker + Container deployment for FalloutCast (see DEPLOY.md).",
  "type": "module",
  "scripts": {
    "build:web": "FALLOUTCAST_API_URL=/api npm --prefix web run build",
    "typecheck:worker": "tsc -p worker/tsconfig.json",
    "check": "npm run build:web && npm run typecheck:worker",
    "deploy": "npm run check && wrangler deploy",
    "tail": "wrangler tail"
  },
  "dependencies": {
    "@cloudflare/containers": "^0.3.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260811.1",
    "typescript": "^5.6.3",
    "wrangler": "^4.123.0"
  }
}
